# Copy to .env and fill in the two IDs from the OpenAI dashboard.
# Both are identifiers, not secrets — neither is an API key.

# Organization Settings > Security > Workload Identity Provider
OPENAI_IDENTITY_PROVIDER_ID=

# Project > Service accounts
OPENAI_SERVICE_ACCOUNT_ID=

# Second workload, created by ./setup-vault.sh and used by ./exchange-team.sh.
# Each workload needs its own mapping on the SAME provider — see README.
OPENAI_SERVICE_ACCOUNT_ID_PAYMENTS=
OPENAI_PROJECT_ID_PAYMENTS=

# Sent as the `audience` at mint time. Must equal the Audience field on the
# OpenAI Workload Identity Provider, or the exchange fails with invalid_subject_token.
OPENAI_AUDIENCE=https://api.openai.com/v1

# Only used by `./use-token.sh --consume`. Pick one from the list that
# `./use-token.sh` prints. Leave blank if you are stopping at step 3a.
OPENAI_MODEL=

# Vault dev root token. run-vault.sh REQUIRES this and exits without it.
# Generate one:  openssl rand -hex 24
VAULT_DEV_ROOT_TOKEN=

# Must equal VAULT_DEV_ROOT_TOKEN. Used by the scripts that talk to Vault.
VAULT_TOKEN=

# The address Vault advertises, and what the SPIFFE issuer URL below defaults to.
# Point it at a public HTTPS URL if OpenAI needs to fetch discovery/JWKS itself.
VAULT_API_ADDR=http://127.0.0.1:8200

# Enterprise licence file. run-vault.sh mounts it read-only and validates its
# signature/expiry before starting. Point this at a real .hclic on this machine;
# it is never copied into the repo.
VAULT_LICENSE_FILE=

# SPIFFE secrets engine. Trust domain prefixes every SVID `sub`. The issuer URL
# is the `iss` claim and must equal what you register with OpenAI, so it has to be
# a public HTTPS URL if OpenAI fetches discovery/JWKS itself. It defaults to
# ${VAULT_API_ADDR}/v1/spiffe — leave it unset unless you need a different host.
SPIFFE_TRUST_DOMAIN=lab.example.org
#SPIFFE_ISSUER_URL=https://vault.example.com/v1/spiffe

VAULT_ADDR=http://127.0.0.1:8200
