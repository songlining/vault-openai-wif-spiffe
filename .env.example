# Copy to .env and fill in the two IDs from the OpenAI dashboard.
# Both are identifiers, not secrets — neither is an API key.

# Organization Settings > Security > Workload Identity Provider
OPENAI_IDENTITY_PROVIDER_ID=

# Project > Service accounts
OPENAI_SERVICE_ACCOUNT_ID=

# Must match the role's client_id, which becomes the token's `aud` claim.
OPENAI_AUDIENCE=https://api.openai.com/v1

# Only used by `./use-token.sh --consume`. Pick one from the list that
# `./use-token.sh` prints. Leave blank if you are stopping at step 3a.
OPENAI_MODEL=

VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=root
